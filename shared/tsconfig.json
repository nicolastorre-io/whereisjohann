{
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": "src",
    "rootDir": "src",
    "declaration": true,
    "module": "CommonJS",
    "target": "ES2015",
    "composite": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "strict": true
  },
  "include": ["src"]
}
